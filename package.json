{
  "name": "savaenergy-daily-drilling-report",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --parallel --filter '*' dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter web --filter schema --filter api test",
    "build": "bun run --filter '*' build",
    "db:seed": "bun run --filter api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
